# Any Postgres works. For a globally reachable database use a hosted provider,
# e.g. Neon:     postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/encrypta?sslmode=require
#      Supabase: postgresql://postgres.xxx:pass@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://encrypta:encrypta@localhost:5432/encrypta

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Preset administrator for /admin. Empty password disables the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Email for one-time passcodes. Leave SMTP_HOST empty in development and the
# codes are printed to this server's log as [DEV MAIL] lines.
# Gmail: smtp.gmail.com / 587 / your address / an App Password
# Resend: smtp.resend.com / 587 / resend / your API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Encrypta <no-reply@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# Comma-separated origins allowed to call the API (only needed when the
# frontend is served from a different origin, e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# WebRTC. STUN is enough on most networks; add TURN for strict corporate/mobile NAT.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
